# BasicBasicFlow

main: kit: flow: BasicBasicFlow:
{
  entity: "basic",
  kind: "basic",
  name: "BasicBasicFlow",
  step: [
    {
      input: {
        ref: "basic_ref01"
      }

      match: {
        event_definition_id: "event_definition01"
      }

      op: "create"
    }

    {
      input: {
        ref: "basic_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "basic01"
      }

      op: "remove"
    }
  ],
  "key$": "BasicBasicFlow"
}